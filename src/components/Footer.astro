---
const year = new Date().getFullYear();
---

<footer class="bg-brand-navy-950 text-brand-steel-300">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-4 lg:px-8">
    <div class="lg:col-span-2">
      <p class="text-lg font-semibold text-white">Sector Technology Inc.</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed">
        CNC plasma and oxy-fuel cutting machines, controls, and retrofits — serving fabricators and
        manufacturers across North America, Europe, and the Pacific Rim since 1979.
      </p>
      <address class="mt-4 space-y-1 text-sm not-italic">
        <p>2000 Elizabeth St, Nicholasville, KY 40356</p>
        <p>
          <a href="tel:+18598818113" class="hover:text-white hover:underline">(859) 881-8113</a>
          &nbsp;·&nbsp; Fax (859) 881-8114
        </p>
        <p>
          <a href="mailto:sales@sectortechnologyinc.com" class="hover:text-white hover:underline">sales@sectortechnologyinc.com</a>
        </p>
      </address>
    </div>

    <nav aria-label="Products and services">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Products</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/machines/" class="hover:text-white hover:underline">Machines</a></li>
        <li><a href="/machines/compare/" class="hover:text-white hover:underline">Compare Machines</a></li>
        <li><a href="/products/plasma-systems/" class="hover:text-white hover:underline">Plasma Systems</a></li>
        <li><a href="/products/controls/" class="hover:text-white hover:underline">Controls</a></li>
      </ul>
    </nav>

    <nav aria-label="Services">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Services</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/services/retrofits/" class="hover:text-white hover:underline">Retrofits</a></li>
        <li><a href="/services/technical-service/" class="hover:text-white hover:underline">Technical Service</a></li>
        <li><a href="/services/training/" class="hover:text-white hover:underline">Training</a></li>
        <li><a href="/services/spare-parts/" class="hover:text-white hover:underline">Spare Parts</a></li>
        <li><a href="/services/trade-ins/" class="hover:text-white hover:underline">Trade-Ins</a></li>
        <li><a href="/services/used-machinery/" class="hover:text-white hover:underline">Used Machinery</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs text-brand-steel-300 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <p>&copy; {year} Sector Technology Inc. All rights reserved.</p>
      <nav aria-label="Legal and utility">
        <ul class="flex gap-4">
          <li><a href="/about/" class="hover:text-white hover:underline">About</a></li>
          <li><a href="/partners/" class="hover:text-white hover:underline">Partners</a></li>
          <li><a href="/contact/" class="hover:text-white hover:underline">Contact</a></li>
          <li><a href="/quote/" class="hover:text-white hover:underline">Request a Quote</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
