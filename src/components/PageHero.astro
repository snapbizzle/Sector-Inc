---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, intro, crumbs = [] } = Astro.props;
---

<section class="border-b border-brand-steel-200 bg-brand-steel-100">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-brand-steel-700">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {c.href ? (
              <a href={c.href} class="hover:underline">{c.label}</a>
            ) : (
              <span class="text-brand-navy-950">{c.label}</span>
            )}
          </>
        ))}
      </nav>
    )}
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-blue-500">{eyebrow}</p>
    )}
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-brand-navy-950">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-steel-700">{intro}</p>}
  </div>
</section>
