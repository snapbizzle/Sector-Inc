---
interface Props {
  title: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const { title, body, ctaLabel = 'Request a Quote', ctaHref = '/quote/' } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="flex flex-col items-start gap-6 rounded-2xl bg-brand-navy-900 px-8 py-12 text-white sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-extrabold">{title}</h2>
      <p class="mt-2 max-w-xl text-brand-steel-200">{body}</p>
    </div>
    <a
      href={ctaHref}
      class="inline-flex shrink-0 items-center rounded-md bg-brand-amber-500 px-6 py-3 text-sm font-semibold text-brand-navy-950 shadow-sm hover:bg-brand-amber-600"
    >
      {ctaLabel}
    </a>
  </div>
</section>
