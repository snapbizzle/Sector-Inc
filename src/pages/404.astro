---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="The page you're looking for couldn't be found."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-blue-500">404</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-brand-navy-950">Page not found</h1>
    <p class="mt-4 text-lg leading-relaxed text-brand-steel-700">
      The page you're looking for may have moved. Try one of these instead:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex items-center rounded-md bg-brand-amber-500 px-5 py-2.5 text-sm font-semibold text-brand-navy-950 shadow-sm hover:bg-brand-amber-600">Home</a>
      <a href="/machines/" class="inline-flex items-center rounded-md border border-brand-steel-300 px-5 py-2.5 text-sm font-semibold text-brand-navy-950 hover:bg-brand-steel-100">Machines</a>
      <a href="/contact/" class="inline-flex items-center rounded-md border border-brand-steel-300 px-5 py-2.5 text-sm font-semibold text-brand-navy-950 hover:bg-brand-steel-100">Contact Us</a>
    </div>
  </section>
</Layout>
