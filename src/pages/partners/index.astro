---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import DataGapNote from '../../components/DataGapNote.astro';
import CtaBand from '../../components/CtaBand.astro';

const groups = [
  {
    category: 'Plasma Systems',
    partners: ['Hypertherm®', 'ITT Kaliburn®', 'Thermal Dynamics®'],
  },
  {
    category: 'CNC Controls',
    partners: ['Hypertherm Automation®', 'ITT Burny®'],
  },
  {
    category: 'Technical Service — OEM Certified',
    partners: ['Hypertherm®', 'ITT CMC-Kaliburn®', 'Thermadyne®', 'Bosch Rexroth®'],
  },
  {
    category: 'Oxy-Fuel Cutting Torches',
    partners: ['Harris®', 'Victor®', 'Oxweld®'],
  },
];
---

<Layout
  title="Partners"
  description="Sector Technology is a certified OEM for Hypertherm, ITT Kaliburn, ITT Burny, Thermal Dynamics, Thermadyne, Bosch Rexroth, Harris, Victor, and Oxweld."
>
  <PageHero
    eyebrow="Partners"
    title="Our Partners"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Partners' }]}
    intro="We're a certified OEM for the plasma, control, and cutting-torch brands fabricators already trust."
  />

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {groups.map((group) => (
        <div class="rounded-lg border border-brand-steel-200 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-blue-500">{group.category}</h2>
          <ul class="mt-3 space-y-1.5 text-base text-brand-steel-700">
            {group.partners.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8">
      <DataGapNote
        notes={[
          "The original site's Partners page displayed six logo images, loaded from broken local file paths (five of the six could not be matched to a brand from visible context — only Praxair's logo was identifiable). Rather than guess or reuse someone else's trademarked logo without permission, this page lists the OEM/brand relationships that are stated in Sector's own site text elsewhere. If you'd like real partner logos displayed here, please supply current, licensed logo files (or confirm these are still Sector's active partners) and we'll add them.",
        ]}
      />
    </div>
  </section>

  <CtaBand
    title="Questions about a specific brand or system?"
    body="We can tell you which partner systems fit your process and budget."
    ctaLabel="Contact Us"
    ctaHref="/contact/"
  />
</Layout>
