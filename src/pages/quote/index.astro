---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactStrip from '../../components/ContactStrip.astro';

const machines = await getCollection('machines');
const order = ['photon', 'gamma', 'spectrum', 'sti-550hd', 'sti-200hd', 'sti-100hd', 'sti-800hd'];
const sorted = machines.sort((a, b) => order.indexOf(a.data.urlSlug) - order.indexOf(b.data.urlSlug));
---

<Layout
  title="Request a Quote"
  description="Request a quote from Sector Technology on a new machine, a retrofit, spare parts, or a trade-in."
>
  <PageHero
    eyebrow="Sales"
    title="Request a Quote"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Request a Quote' }]}
    intro="Tell us what you're cutting, and what you need — a new machine, a retrofit, spare parts, or a trade-in — and our sales team will follow up directly."
  />

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <form
        id="quote-form"
        class="lg:col-span-2"
        method="POST"
        action="/api/quote"
        novalidate
      >
        <!-- Honeypot: hidden from real users via CSS; a bot filling this out causes the submission to be rejected server-side. -->
        <p class="hidden" aria-hidden="true">
          <label for="website">Leave this field blank</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-semibold text-brand-navy-950">
              Name <span class="text-brand-amber-600" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            />
          </div>
          <div>
            <label for="company" class="block text-sm font-semibold text-brand-navy-950">Company</label>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-brand-navy-950">
              Email <span class="text-brand-amber-600" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-brand-navy-950">Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="address" class="block text-sm font-semibold text-brand-navy-950">Address</label>
            <input
              type="text"
              id="address"
              name="address"
              autocomplete="street-address"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="machine" class="block text-sm font-semibold text-brand-navy-950">Machine of Interest</label>
            <select
              id="machine"
              name="machine"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 bg-white px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            >
              <option value="">Not sure / other</option>
              {sorted.map((m) => <option value={m.data.urlSlug}>{m.data.name}</option>)}
              <option value="retrofit">Retrofit</option>
              <option value="spare-parts">Spare Parts</option>
              <option value="trade-in">Trade-In</option>
              <option value="used">Used Machinery</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="comments" class="block text-sm font-semibold text-brand-navy-950">Comments</label>
            <textarea
              id="comments"
              name="comments"
              rows="5"
              class="mt-1.5 block w-full rounded-md border border-brand-steel-300 px-3 py-2 text-sm focus:border-brand-blue-500 focus:outline-none focus:ring-1 focus:ring-brand-blue-500"
            ></textarea>
          </div>
        </div>

        <div class="mt-6">
          <button
            type="submit"
            class="inline-flex items-center rounded-md bg-brand-amber-500 px-6 py-3 text-sm font-semibold text-brand-navy-950 shadow-sm hover:bg-brand-amber-600 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Submit Request
          </button>
          <p id="quote-form-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside>
        <div class="rounded-lg border border-brand-steel-200 bg-brand-steel-100 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-steel-700">Prefer to call or email?</h2>
          <div class="mt-3">
            <ContactStrip email="sales@sectortechnologyinc.com" label="Email" />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const machineParam = params.get('machine');
    if (machineParam) {
      const select = document.getElementById('machine');
      if (select instanceof HTMLSelectElement) {
        const match = Array.from(select.options).find((o) => o.value === machineParam);
        if (match) select.value = machineParam;
      }
    }

    const form = document.getElementById('quote-form');
    const status = document.getElementById('quote-form-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !status) return;

      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      status.textContent = 'Sending…';
      status.className = 'mt-3 text-sm text-brand-steel-700';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });

        if (response.ok) {
          form.reset();
          status.textContent = "Thanks — we've received your request and will be in touch shortly.";
          status.className = 'mt-3 text-sm font-semibold text-green-700';
        } else {
          const data = await response.json().catch(() => null);
          status.textContent = data?.error || 'Something went wrong sending your request. Please call or email us instead.';
          status.className = 'mt-3 text-sm font-semibold text-red-700';
        }
      } catch {
        status.textContent = 'Something went wrong sending your request. Please call or email us instead.';
        status.className = 'mt-3 text-sm font-semibold text-red-700';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      }
    });
  </script>
</Layout>
