---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Thank You"
  description="Thank you for your quote request — a member of the Sector Technology sales team will be in touch shortly."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-brand-navy-950">Thank you</h1>
    <p class="mt-4 text-lg leading-relaxed text-brand-steel-700">
      We've received your request and a member of our sales team will be in touch shortly.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-md bg-brand-amber-500 px-6 py-3 text-sm font-semibold text-brand-navy-950 shadow-sm hover:bg-brand-amber-600"
    >
      Back to Home
    </a>
  </section>
</Layout>
