---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContactStrip from '../../../components/ContactStrip.astro';
import CtaBand from '../../../components/CtaBand.astro';
---

<Layout
  title="Spare Parts"
  description="Sector Technology keeps a full inventory of spare parts in stock — order by 3:30pm EST for same-day shipment via UPS within North America."
>
  <PageHero
    eyebrow="Services"
    title="Spare Parts"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }, { label: 'Spare Parts' }]}
    intro="We know customers need to keep running production — that's why we keep a full inventory of spare parts on hand."
  />

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="text-base leading-relaxed text-brand-steel-700">
          We realize that customers need to be running production at all times, which is why we
          maintain a full inventory of spare parts ready to ship. Orders placed by 3:30pm EST
          usually ship the same day via UPS® within North America. If a part isn't a stock item,
          we can usually ship it within 24 hours.
        </p>
        <h2 class="mt-10 text-xl font-bold text-brand-navy-950">Related</h2>
        <ul class="mt-4 flex flex-wrap gap-3 text-sm">
          <li><a href="/services/technical-service/" class="rounded-md border border-brand-steel-300 px-4 py-2 font-semibold text-brand-navy-950 hover:bg-brand-steel-100">Technical Service</a></li>
          <li><a href="/services/trade-ins/" class="rounded-md border border-brand-steel-300 px-4 py-2 font-semibold text-brand-navy-950 hover:bg-brand-steel-100">Trade-Ins</a></li>
          <li><a href="/services/used-machinery/" class="rounded-md border border-brand-steel-300 px-4 py-2 font-semibold text-brand-navy-950 hover:bg-brand-steel-100">Used Machinery</a></li>
        </ul>
      </div>
      <aside>
        <div class="rounded-lg border border-brand-steel-200 bg-brand-steel-100 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-steel-700">Order parts</h2>
          <div class="mt-3">
            <ContactStrip email="sales@sectortechnologyinc.com" label="Email" />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand
    title="Need a part fast?"
    body="Order by 3:30pm EST for same-day shipment within North America."
    ctaLabel="Contact Us"
    ctaHref="/contact/"
  />
</Layout>
