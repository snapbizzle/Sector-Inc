# Copy this file to .env (self-hosted server) and fill in real values.
# When deploying to Cloudflare Pages, set these same three variables in
# the Pages project's Settings > Environment variables instead — do not
# commit a real .env file.

# API key from https://resend.com (Resend is used to send quote-form
# submissions by email instead of the old broken mailto: link).
RESEND_API_KEY=

# Inbox that should receive quote requests, e.g. sales@sectortechnologyinc.com
QUOTE_TO_EMAIL=

# Verified "from" address in your Resend account/domain, e.g.
# quotes@sectortechnologyinc.com. Resend requires the sending domain to
# be verified before this will work — see README.md.
QUOTE_FROM_EMAIL=

# Self-hosted server only — port to listen on (default 8080).
PORT=8080
